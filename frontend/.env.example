# Backend API base URL (leave blank to use Vite proxy in dev)
# For production, set to your deployed backend URL e.g. https://felicity-api.onrender.com/api
VITE_API_URL=

# Socket.io server URL (leave blank to use same origin)
# For production, set to your deployed backend e.g. https://felicity-api.onrender.com
VITE_SOCKET_URL=
